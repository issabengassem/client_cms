# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name (created automatically on first write, doesn't need to exist yet)
MONGODB_DB=cms_command_center

# Long random string used to sign operator session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Static bearer token used by the onboarding Skill's register-site script to
# create new sites without a human logging into the dashboard first.
# Generate the same way as SESSION_SECRET.
ADMIN_API_TOKEN=
